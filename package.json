{
  "name": "portfolio-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "turbo analyze",
    "boundaries": "turbo boundaries",
    "prebuild": "pnpm --filter web lanyard:inputs",
    "build": "turbo build",
    "bump-deps": "pnpm dlx npm-check-updates --cooldown 1d --deep -u && pnpm install",
    "bump-ui": "pnpm dlx shadcn@latest add --all --overwrite -c packages/design-system",
    "check": "ultracite check",
    "clean": "git clean -xdf node_modules",
    "dev": "turbo dev",
    "fix": "ultracite fix",
    "security:check": "pnpm audit --audit-level=moderate",
    "test": "turbo test",
    "test:browser": "playwright test",
    "test:instant": "EXPOSE_TESTING_API=1 pnpm build && playwright test --config playwright.instant.config.ts",
    "translate": "turbo translate",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@next/playwright": "16.4.5",
    "@playwright/test": "^1.65.0",
    "@repo/typescript-config": "workspace:*",
    "@turbo/gen": "^2.11.10",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "ultracite": "8.1.1",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
