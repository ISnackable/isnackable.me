{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "buildCommand": "pnpm --dir ../.. run build --filter=web",
      "ignoreCommand": "node scripts/skip-ci.js"
    },
    "files": {
      "root": "apps/app",
      "framework": "nextjs",
      "ignoreCommand": "node scripts/skip-ci.js"
    },
    "studio": {
      "root": "apps/studio",
      "framework": "vite",
      "buildCommand": "pnpm run build",
      "devCommand": "pnpm run dev --port $PORT",
      "ignoreCommand": "node ../web/scripts/skip-ci.js",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/studio{/((?!(?:static|node_modules)(?:/|$)|[@.]|sanity\\.config\\.ts(?:/|$)).*)}?",
          "destination": "/studio/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/files/:path*",
      "destination": { "service": "files" }
    },
    {
      "source": "/:locale(en|ja|zh)/files/:path*",
      "destination": { "service": "files" }
    },
    {
      "source": "/files-static/:path*",
      "destination": { "service": "files" }
    },
    {
      "source": "/api/files/:path*",
      "destination": { "service": "files" }
    },
    {
      "source": "/studio/:path*",
      "destination": { "service": "studio" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
