{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "buildCommand": "pnpm --dir ../.. run build --filter=web",
      "ignoreCommand": "node scripts/skip-ci.js"
    },
    "files": {
      "root": "apps/app",
      "framework": "nextjs",
      "ignoreCommand": "node scripts/skip-ci.js"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": { "pre": "files." } }],
      "destination": { "service": "files" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
