# Optional server credentials
ARCJET_KEY=""
# Read-only Viewer token, shared with browsers only during authenticated previews.
SANITY_API_READ_TOKEN=""
SANITY_REVALIDATE_SECRET=""

# Optional GitHub Discussions comments. Get these four public identifiers from https://giscus.app.
# Leave blank to disable comments. No GitHub token is required.
GISCUS_REPO=""
GISCUS_REPO_ID=""
GISCUS_CATEGORY=""
GISCUS_CATEGORY_ID=""

# Required public Sanity settings
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"

# Optional public analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# The portfolio origin also serves the canonical Files routes
NEXT_PUBLIC_WEB_URL="http://localhost:3001"
