{
  "name": "web",
  "private": true,
  "scripts": {
    "analyze": "ANALYZE=true npm run build",
    "prebuild": "pnpm --filter @repo/cms typegen && pnpm lanyard:previews",
    "build": "next build",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "predev": "pnpm --filter @repo/cms typegen",
    "dev": "next dev -p 3001",
    "lanyard:inputs": "node scripts/lanyard/inputs.mjs",
    "lanyard:previews": "node scripts/lanyard/generate.mjs",
    "lanyard:smoke": "node scripts/lanyard/generate.mjs --smoke",
    "start": "next start -p 3001",
    "test": "NODE_ENV=test vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@arcjet/next": "1.15.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@repo/analytics": "workspace:*",
    "@repo/cms": "workspace:*",
    "@repo/comments": "workspace:*",
    "@repo/config": "workspace:*",
    "@repo/design-system": "workspace:*",
    "@repo/internationalization": "workspace:*",
    "@repo/next-config": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/security": "workspace:*",
    "@repo/seo": "workspace:*",
    "@repo/typst": "workspace:*",
    "@sentry/nextjs": "^11.11.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@thesvg/react": "^4.0.4",
    "@zanreal/nemo": "^3.0.2",
    "import-in-the-middle": "^3.6.0",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "next": "16.4.6",
    "next-sanity": "^13.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "require-in-the-middle": "8.0.1",
    "server-only": "0.0.1",
    "smol-toml": "^1.9.1",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/arimo": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.1",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@next/env": "16.4.5",
    "@repo/typescript-config": "workspace:*",
    "@sanity/client": "^8.15.0",
    "@sanity/mutator": "6.22.0",
    "@sparticuz/chromium": "153.0.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.187.0",
    "groq-js": "2.0.1",
    "jsdom": "^31.0.0",
    "playwright-core": "1.63.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.5",
    "tsup": "9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
