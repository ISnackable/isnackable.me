{
  "name": "app",
  "private": true,
  "scripts": {
    "analyze": "ANALYZE=true npm run build",
    "prebuild": "node scripts/prepare-viewers.mjs",
    "build": "next build",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "connect:onedrive": "node --conditions=react-server --env-file=.env.local --import tsx scripts/connect-onedrive.ts",
    "predev": "node scripts/prepare-viewers.mjs",
    "dev": "next dev -p 3000",
    "start": "next start",
    "test": "NODE_ENV=test vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@azure/msal-node": "7.2.3",
    "@repo/config": "workspace:*",
    "@repo/design-system": "workspace:*",
    "@repo/internationalization": "workspace:*",
    "@repo/next-config": "workspace:*",
    "@repo/security": "workspace:*",
    "@repo/seo": "workspace:*",
    "@repo/storage": "workspace:*",
    "@t3-oss/env-nextjs": "^0.13.11",
    "client-zip": "2.5.1",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "swr": "2.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
