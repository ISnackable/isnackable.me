# Optional server credentials
ARCJET_KEY=""

# The portfolio origin also serves the canonical Files routes
NEXT_PUBLIC_WEB_URL="http://localhost:3001"

# Optional published portfolio branding. Use the same project and dataset as the web app.
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
# Set a read-only token if the dataset requires authenticated reads.
SANITY_API_READ_TOKEN=""

# Path from the root of the owner's OneDrive
FILES_BASE_DIRECTORY="Public"
FILES_CLIENT_ID=""
FILES_CLIENT_SECRET=""
# Set the Entra tenant ID for a work or school account. Leave empty for personal.
FILES_TENANT_ID=""
# Optional extra exact HTTPS hostnames for content and thumbnails
FILES_CONTENT_HOSTS=""
# Generate with openssl rand -base64 32
FILES_SIGNING_SECRET=""

# Encrypted OneDrive owner connection
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
