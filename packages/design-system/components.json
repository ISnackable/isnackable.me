{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-vega",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "styles/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "aliases": {
    "components": "@repo/design-system/components",
    "utils": "@repo/design-system/lib/utils",
    "ui": "@repo/design-system/components/ui",
    "lib": "@repo/design-system/lib",
    "hooks": "@repo/design-system/hooks"
  },
  "registries": {
    "@extend": "https://www.extend.ai/ui/r/styles/{style}/{name}.json",
    "@aceternity": "https://ui.aceternity.com/registry/{name}.json",
    "@kibo-ui": "https://www.kibo-ui.com/r/{name}.json",
    "@magicui": "https://magicui.design/r/{name}",
    "@efferd": "https://efferd.com/r/{name}.json",
    "@react-bits": "https://reactbits.dev/r/{name}.json"
  }
}
